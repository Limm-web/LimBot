# ==============================================================================
# LimBot — Environment Variables Template
# Copy this file to .env and fill in with your real credentials:
# cp .env.example .env
# ==============================================================================

# Telegram Bot API Token (Obtain via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq Cloud API Key (Obtain via https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Spreadsheet Master Template ID
MASTER_SHEET_ID=your_master_google_spreadsheet_id_here
